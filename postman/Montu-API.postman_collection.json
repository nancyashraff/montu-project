{
  "info": {
    "_postman_id": "a7c3e1d0-4b2f-4f8a-9c11-montu-api-2026",
    "name": "Montu API",
    "description": "Auth and protected Task CRUD endpoints for the Montu backend.\n\n1. Set `baseUrl` to `http://localhost:3000` locally, or to the live Render URL.\n2. Run **Sign Up** or **Sign In** — the token is saved automatically.\n3. Task requests send `Authorization: Bearer {{token}}`.\n4. **Create Task** saves `taskId` for get/update/delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ping",
            "description": "Public health check. No authentication required."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup",
            "description": "Register a new user. Always assigns role `user`. Sending `role: admin` is 403 unless no admin exists yet. Saves the JWT to `{{token}}`."
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signin",
            "description": "Log in with email and password. Saves the JWT to `{{token}}`."
          }
        },
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Two\",\n  \"email\": \"admin2@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admins",
            "description": "Create an admin account. Requires a Bearer token whose role is `admin`. Regular users receive 403."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks",
            "description": "Returns all tasks owned by the authenticated user."
          }
        },
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('taskId', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish Task 3.4\",\n  \"description\": \"CRUD, Postman collection, and deployment\",\n  \"status\": \"todo\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks",
            "description": "Create a task. `title` is required. `status` may be `todo`, `in-progress`, or `done`. Saves the new id to `{{taskId}}`."
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Get one task by id. Returns 404 if it does not belong to the authenticated user."
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish Task 3.4\",\n  \"description\": \"Updated description\",\n  \"status\": \"in-progress\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Update one or more fields on a task owned by the authenticated user."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Delete a task owned by the authenticated user."
          }
        }
      ]
    }
  ]
}
