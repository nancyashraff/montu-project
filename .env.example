PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Optional in development. If omitted, a secret is generated and written to .env on first start.
# Required in production.
# JWT_SECRET=replace-with-a-long-random-string

# Default admin created on startup if this email does not exist yet.
# Testers can sign in with these credentials, then POST /api/auth/admins to add more.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234
